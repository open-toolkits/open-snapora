{
  "name": "@open-snapora/electron",
  "version": "1.0.2",
  "description": "Electron host adapter and plugin for open-snapora",
  "license": "MIT",
  "author": "open-snapora authors",
  "homepage": "https://github.com/open-toolkits/open-snapora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-toolkits/open-snapora.git",
    "directory": "packages/electron"
  },
  "bugs": {
    "url": "https://github.com/open-toolkits/open-snapora/issues"
  },
  "keywords": [
    "screenshot",
    "annotation",
    "electron",
    "desktopCapturer",
    "multi-monitor",
    "open-snapora"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/main/index.cjs",
  "module": "./dist/main/index.mjs",
  "types": "./dist/main/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main/index.d.ts",
        "default": "./dist/main/index.mjs"
      },
      "require": {
        "types": "./dist/main/index.d.cts",
        "default": "./dist/main/index.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/preload/index.d.ts",
        "default": "./dist/preload/index.mjs"
      },
      "require": {
        "types": "./dist/preload/index.d.cts",
        "default": "./dist/preload/index.cjs"
      }
    },
    "./preload/auto": {
      "types": "./dist/preload/auto.d.cts",
      "require": "./dist/preload/auto.cjs",
      "default": "./dist/preload/auto.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/sync-overlay.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "devDependencies": {
    "@open-snapora/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "electron": "^34.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
