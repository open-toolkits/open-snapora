{
  "name": "@open-snapora/overlay",
  "version": "1.0.4",
  "private": true,
  "description": "Host-agnostic Web screenshot annotation and overlay editor for open-snapora",
  "license": "MIT",
  "author": "open-snapora authors",
  "homepage": "https://github.com/open-toolkits/open-snapora#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-toolkits/open-snapora.git",
    "directory": "packages/overlay"
  },
  "bugs": {
    "url": "https://github.com/open-toolkits/open-snapora/issues"
  },
  "keywords": [
    "screenshot",
    "annotation",
    "overlay",
    "canvas",
    "pin-to-desktop",
    "open-snapora"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pinned": {
      "types": "./dist/pinned.d.ts",
      "import": "./dist/pinned.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-snapora/shared": "workspace:*",
    "desklog": "^1.0.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
