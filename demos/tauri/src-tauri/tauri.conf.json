{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-snapora-tauri-demo",
  "version": "0.1.0",
  "identifier": "com.opensnapora.tauridemo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "open-snapora Tauri 演示",
        "width": 900,
        "height": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
